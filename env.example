# AdMob Configuration
# Get these IDs from https://admob.google.com
# Copy this file to .env and fill in your actual values

# AdMob App ID (format: ca-app-pub-XXXXXXXXXXXXXXXX~XXXXXXXXXX)
# Found in: AdMob Console → Apps → Your App → App settings
ADMOB_APP_ID=ca-app-pub-3940256099942544~3347511713

# Rewarded Ad Unit ID (format: ca-app-pub-XXXXXXXXXXXXXXXX/XXXXXXXXXX)
# Found in: AdMob Console → Apps → Your App → Ad units → Rewarded ad unit
ADMOB_REWARDED_AD_UNIT_ID=ca-app-pub-3940256099942544/5224354917

