7","\u0413\u0435\u043b\u0438\u0439","\u0410\u0437\u043e\u0442","\u041a\u0438\u0441\u043b\u043e\u0440\u043e\u0434"],answer:4},{id:"1-8",question:"\u0412 \u0441\u043a\u0430\u0437\u043a\u0435 '\u041a\u0440\u0430\u0441\u043d\u0430\u044f \u0428\u0430\u043f\u043e\u0447\u043a\u0430', \u043a\u0430\u043a\u0438\u043c \u0436\u0438\u0432\u043e\u0442\u043d\u044b\u043c \u043f\u0440\u0438\u0442\u0432\u043e\u0440\u0438\u043b\u0441\u044f \u0411\u043e\u043b\u044c\u0448\u043e\u0439 \u0417\u043b\u043e\u0439 \u0412\u043e\u043b\u043a?",options:["\u0411\u0430\u0431\u0443\u0448\u043a\u0430","\u0414\u0440\u043e\u0432\u043e\u0441\u0435\u043a","\u041e\u0445\u043e\u0442\u043d\u0438\u043a","\u0424\u0435\u0440\u043c\u0435\u0440"],answer:1},{id:"1-9",question:"\u041a\u0430\u043a\u043e\u0439 \u0438\u0437 \u044d\u0442\u0438\u0445 \u043e\u0432\u043e\u0449\u0435\u0439 \u0442\u0430\u043a\u0436\u0435 \u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f \u043d\u0430\u0437\u0432\u0430\u043d\u0438\u0435\u043c \u0446\u0432\u0435\u0442\u0430?",options:["\u041a\u0430\u0440\u0442\u043e\u0444\u0435\u043b\u044c","\u041c\u043e\u0440\u043a\u043e\u0432\u044c","\u041b\u0443\u043a","\u0421\u0430\u043b\u0430\u0442"],answer:2},{id:"1-10",question:"\u041a\u0430\u043a\u043e\u0439 \u043c\u0443\u0437\u044b\u043a\u0430\u043b\u044c\u043d\u044b\u0439 \u0438\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442 \u0438\u043c\u0435\u0435\u0442 \u043a\u043b\u0430\u0432\u0438\u0430\u0442\u0443\u0440\u0443 \u0438 \u0440\u044f\u0434 \u0447\u0435\u0440\u043d\u043e-\u0431\u0435\u043b\u044b\u0445 \u043a\u043b\u0430\u0432\u0438\u0448?",options:["\u0413\u0438\u0442\u0430\u0440\u0430","\u0411\u0430\u0440\u0430\u0431\u0430\u043d\u044b","\u0421\u043a\u0440\u0438\u043f\u043a\u0430","\u0424\u043e\u0440\u0442\u0435\u043f\u0438\u0430\u043d\u043e"],answer:4}],[{id:"2-1",question:"\u0418\u0441\u0442\u043e\u0440\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u043f\u0435\u0440\u0438\u043e\u0434, \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u044b\u0439 \u043a\u0430\u043a '\u042d\u043f\u043e\u0445\u0430 \u041f\u0440\u043e\u0441\u0432\u0435\u0449\u0435\u043d\u0438\u044f', \u0445\u0430\u0440\u0430\u043a\u0442\u0435\u0440\u0438\u0437\u0443\u0435\u0442\u0441\u044f \u0441\u043e\u0441\u0440\u0435\u0434\u043e\u0442\u043e\u0447\u0435\u043d\u0438\u0435\u043c \u043d\u0430 \u0447\u0435\u043c \u0438\u0437 \u043f\u0435\u0440\u0435\u0447\u0438\u0441\u043b\u0435\u043d\u043d\u043e\u0433\u043e?",options:["\u0412\u0435\u0440\u0435 \u0438 \u043f\u0440\u0435\u0434\u0430\u043d\u043d\u043e\u0441\u0442\u0438","\u0420\u0430\u0437\u0443\u043c\u0435 \u0438 \u0438\u043d\u0434\u0438\u0432\u0438\u0434\u0443\u0430\u043b\u0438\u0437\u043c\u0435","\u0417\u0430\u0432\u043e\u0435\u0432\u0430\u043d\u0438\u0438 \u0438 \u0440\u0430\u0441\u0448\u0438\u0440\u0435\u043d\u0438\u0438","\u0421\u0443\u0435\u0432\u0435\u0440\u0438\u0438 \u0438 \u0444\u043e\u043b\u044c\u043a\u043b\u043e\u0440\u0435"],answer:2},{id:"2-2",question:"\u041a\u0430\u043a\u043e\u0432\u043e \u043d\u0430\u0443\u0447\u043d\u043e\u0435 \u043d\u0430\u0437\u0432\u0430\u043d\u0438\u0435 \u0441\u0442\u0440\u0430\u0445\u0430 \u043f\u0443\u0431\u043b\u0438\u0447\u043d\u044b\u0445 \u0432\u044b\u0441\u0442\u0443\u043f\u043b\u0435\u043d\u0438\u0439?",options:["\u0410\u0433\u043e\u0440\u0430\u0444\u043e\u0431\u0438\u044f","\u0413\u043b\u043e\u0441\u0441\u043e\u0444\u043e\u0431\u0438\u044f","\u041a\u043b\u0430\u0443\u0441\u0442\u0440\u043e\u0444\u043e\u0431\u0438\u044f","\u0413\u0438\u0434\u0440\u043e\u0444\u043e\u0431\u0438\u044f"],answer:2},{id:"2-3",question:"\u041a\u0430\u043a\u0430\u044f \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u0430\u044f \u043e\u043f\u0435\u0440\u0430, \u043d\u0430\u043f\u0438\u0441\u0430\u043d\u043d\u0430\u044f \u0414\u0436\u0430\u043a\u043e\u043c\u043e \u041f\u0443\u0447\u0447\u0438\u043d\u0438, \u043f\u0440\u043e\u0438\u0441\u0445\u043e\u0434\u0438\u0442 \u0432 \u0420\u0438\u043c\u0435?",options:["\u0411\u043e\u0433\u0435\u043c\u0430","\u041c\u0430\u0434\u0430\u043c \u0411\u0430\u0442\u0442\u0435\u0440\u0444\u043b\u044f\u0439","\u0422\u0443\u0440\u0430\u043d\u0434\u043e\u0442","\u0422\u043e\u0441\u043a\u0430"],answer:4},{id:"2-4",question:"\u041a\u0430\u043a \u043d\u0430\u0437\u044b\u0432\u0430\u0435\u0442\u0441\u044f \u0432\u0435\u0449\u0435\u0441\u0442\u0432\u043e, \u043a\u043e\u0442\u043e\u0440\u043e\u0435 \u0443\u0441\u043a\u043e\u0440\u044f\u0435\u0442 \u0445\u0438\u043c\u0438\u0447\u0435\u0441\u043a\u0443\u044e \u0440\u0435\u0430\u043a\u0446\u0438\u044e, \u043d\u0435 \u0440\u0430\u0441\u0445\u043e\u0434\u0443\u044f\u0441\u044c \u0432 \u043f\u0440\u043e\u0446\u0435\u0441\u0441\u0435?",options:["\u0418\u043d\u0433\u0438\u0431\u0438\u0442\u043e\u0440","\u041a\u0430\u0442\u0430\u043b\u0438\u0437\u0430\u0442\u043e\u0440","\u0420\u0430\u0441\u0442\u0432\u043e\u0440\u0438\u0442\u0435\u043b\u044c","\u0424\u0435\u0440\u043c\u0435\u043d\u0442"],answer:2},{id:"2-5",question:"\u041a\u0430\u043a \u043d\u0430\u0437\u044b\u0432\u0430\u0435\u0442\u0441\u044f \u0432\u044b\u043c\u044b\u0448\u043b\u0435\u043d\u043d\u044b\u0439 \u0433\u043e\u0440\u043e\u0434, \u0432 \u043a\u043e\u0442\u043e\u0440\u043e\u043c \u0436\u0438\u0432\u0443\u0442 '\u0421\u0438\u043c\u043f\u0441\u043e\u043d\u044b'?",options:["\u0421\u043f\u0440\u0438\u043d\u0433\u0444\u0438\u043b\u0434","\u041a\u0443\u0430\u0445\u043e\u0433","\u042e\u0436\u043d\u044b\u0439 \u041f\u0430\u0440\u043a","\u0411\u0435\u0434\u0440\u043e\u043a"],answer:1},{id:"2-6",question:"\u041a\u0430\u043a \u043d\u0430\u0437\u044b\u0432\u0430\u0435\u0442\u0441\u044f \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u0430\u044f \u0430\u0441\u0442\u0440\u043e\u043d\u043e\u043c\u0438\u0447\u0435\u0441\u043a\u0430\u044f \u043e\u0431\u0441\u0435\u0440\u0432\u0430\u0442\u043e\u0440\u0438\u044f, \u0440\u0430\u0441\u043f\u043e\u043b\u043e\u0436\u0435\u043d\u043d\u0430\u044f \u043d\u0430 \u043e\u0441\u0442\u0440\u043e\u0432\u0435 \u0413\u0430\u0432\u0430\u0439\u0438?",options:["\u041a\u043e\u0441\u043c\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u0442\u0435\u043b\u0435\u0441\u043a\u043e\u043f \u0425\u0430\u0431\u0431\u043b","\u041e\u0431\u0441\u0435\u0440\u0432\u0430\u0442\u043e\u0440\u0438\u044f \u0410\u0440\u0435\u0441\u0438\u0431\u043e","\u041e\u0431\u0441\u0435\u0440\u0432\u0430\u0442\u043e\u0440\u0438\u044f \u041c\u0430\u0443\u043d\u0430-\u041a\u0435\u0430","\u041e\u0431\u0441\u0435\u0440\u0432\u0430\u0442\u043e\u0440\u0438\u044f \u041f\u0430\u043b\u043e\u043c\u0430\u0440"],answer:3},{id:"2-7",question:"\u041f\u0435\u0440\u0438\u043e\u0434 '\u0420\u0435\u043d\u0435\u0441\u0441\u0430\u043d\u0441\u0430', \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u044b\u0439 \u0441\u0432\u043e\u0438\u043c \u0438\u0441\u043a\u0443\u0441\u0441\u0442\u0432\u043e\u043c \u0438 \u043a\u0443\u043b\u044c\u0442\u0443\u0440\u043e\u0439, \u043d\u0430\u0447\u0430\u043b\u0441\u044f \u0432 \u043a\u0430\u043a\u043e\u0439 \u0441\u0442\u0440\u0430\u043d\u0435?",options:["\u0424\u0440\u0430\u043d\u0446\u0438\u044f","\u0418\u0441\u043f\u0430\u043d\u0438\u044f","\u0418\u0442\u0430\u043b\u0438\u044f","\u0413\u0435\u0440\u043c\u0430\u043d\u0438\u044f"],answer:3},{id:"2-8",question:"\u0412 \u043c\u0438\u0440\u0435 \u0444\u0438\u043d\u0430\u043d\u0441\u043e\u0432, \u043a\u0430\u043a \u043d\u0430\u0437\u044b\u0432\u0430\u0435\u0442\u0441\u044f \u0432\u043d\u0435\u0437\u0430\u043f\u043d\u043e\u0435, \u0440\u0435\u0437\u043a\u043e\u0435 \u043f\u0430\u0434\u0435\u043d\u0438\u0435 \u0446\u0435\u043d \u043d\u0430 \u0430\u043a\u0446\u0438\u0438 \u043f\u043e \u0437\u043d\u0430\u0447\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u043c\u0443 \u0447\u0438\u0441\u043b\u0443 \u0430\u043a\u0446\u0438\u0439?",options:["\u0411\u044b\u0447\u0438\u0439 \u0440\u044b\u043d\u043e\u043a","\u041c\u0435\u0434\u0432\u0435\u0436\u0438\u0439 \u0440\u044b\u043d\u043e\u043a","\u041e\u0431\u0432\u0430\u043b \u0440\u044b\u043d\u043a\u0430","\u0420\u0435\u0446\u0435\u0441\u0441\u0438\u044f"],answer:3},{id:"2-9",question:"\u041a\u0430\u043a\u043e\u0435 \u0438\u0437 \u044d\u0442\u0438\u0445 \u043d\u0430\u0437\u0432\u0430\u043d\u0438\u0439 \u043f\u0440\u0438\u043d\u0430\u0434\u043b\u0435\u0436\u0438\u0442 \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u043e\u0439 \u043a\u0430\u0440\u0442\u0438\u043d\u0435 \u042d\u0434\u0432\u0430\u0440\u0434\u0430 \u041c\u0443\u043d\u043a\u0430?",options:["\u041f\u043e\u0441\u0442\u043e\u044f\u043d\u0441\u0442\u0432\u043e \u043f\u0430\u043c\u044f\u0442\u0438","\u041a\u0440\u0438\u043a","\u0413\u0435\u0440\u043d\u0438\u043a\u0430","\u0417\u0432\u0451\u0437\u0434\u043d\u0430\u044f \u043d\u043e\u0447\u044c"],answer:2},{id:"2-10",question:"\u0417\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u044b\u0439 \u0440\u043e\u043c\u0430\u043d '\u041c\u043e\u0431\u0438 \u0414\u0438\u043a' \u0440\u0430\u0441\u0441\u043a\u0430\u0437\u044b\u0432\u0430\u0435\u0442 \u0438\u0441\u0442\u043e\u0440\u0438\u044e \u043a\u0430\u043f\u0438\u0442\u0430\u043d\u0430 \u0410\u0445\u0430\u0431\u0430, \u043e\u0445\u043e\u0442\u044f\u0449\u0435\u0433\u043e\u0441\u044f \u043d\u0430 \u0431\u043e\u043b\u044c\u0448\u043e\u0433\u043e \u0431\u0435\u043b\u043e\u0433\u043e \u043a\u0438\u0442\u0430. \u041a\u0430\u043a \u0437\u043e\u0432\u0443\u0442 \u043a\u0438\u0442\u0430?",options:["\u041b\u0435\u0432\u0438\u0430\u0444\u0430\u043d","\u041c\u043e\u0431\u0438 \u0414\u0438\u043a","\u0421\u0438\u043d\u044f\u044f \u0411\u043e\u0440\u043e\u0434\u0430","\u041a\u043e\u0441\u0430\u0442\u043a\u0430"],answer:2}],[{id:"3-1",question:"\u0424\u0438\u043b\u043e\u0441\u043e\u0444\u0441\u043a\u0430\u044f \u043a\u043e\u043d\u0446\u0435\u043f\u0446\u0438\u044f 'tabula rasa' (\u0447\u0438\u0441\u0442\u044b\u0439 \u043b\u0438\u0441\u0442) \u043d\u0430\u0438\u0431\u043e\u043b\u0435\u0435 \u0442\u0435\u0441\u043d\u043e \u0441\u0432\u044f\u0437\u0430\u043d\u0430 \u0441 \u043a\u0430\u043a\u0438\u043c \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u043e\u043c?",options:["\u041f\u043b\u0430\u0442\u043e\u043d","\u0414\u0436\u043e\u043d \u041b\u043e\u043a\u043a","\u0421\u043e\u043a\u0440\u0430\u0442","\u0418\u043c\u043c\u0430\u043d\u0443\u0438\u043b \u041a\u0430\u043d\u0442"],answer:2},{id:"3-2",question:"\u0412 '\u0412\u043e\u0439\u043d\u0435 \u0410\u043b\u044b\u0445 \u0438 \u0411\u0435\u043b\u044b\u0445 \u0440\u043e\u0437' \u0432 \u0410\u043d\u0433\u043b\u0438\u0438, \u043a\u0430\u043a\u0438\u0435 \u0434\u0432\u0430 \u0434\u043e\u043c\u0430 \u0431\u044b\u043b\u0438 \u0432 \u043a\u043e\u043d\u0444\u043b\u0438\u043a\u0442\u0435?",options:["\u0422\u044e\u0434\u043e\u0440 \u0438 \u0421\u0442\u044e\u0430\u0440\u0442","\u0419\u043e\u0440\u043a \u0438 \u041b\u0430\u043d\u043a\u0430\u0441\u0442\u0435\u0440","\u0412\u0438\u043d\u0434\u0437\u043e\u0440 \u0438 \u0413\u0430\u043d\u043d\u043e\u0432\u0435\u0440","\u041f\u043b\u0430\u043d\u0442\u0430\u0433\u0435\u043d\u0435\u0442 \u0438 \u0422\u044e\u0434\u043e\u0440"],answer:2},{id:"3-3",question:"\u041a\u0430\u043a \u043d\u0430\u0437\u044b\u0432\u0430\u0435\u0442\u0441\u044f \u043b\u0438\u0442\u0435\u0440\u0430\u0442\u0443\u0440\u043d\u044b\u0439 \u043f\u0440\u0438\u0451\u043c, \u043a\u043e\u0433\u0434\u0430 \u0430\u0432\u0442\u043e\u0440 \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u0435\u0442 \u043f\u0440\u0435\u0434\u043c\u0435\u0442 \u0438\u043b\u0438 \u0438\u0434\u0435\u044e \u0434\u043b\u044f \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043b\u0435\u043d\u0438\u044f \u0447\u0435\u0433\u043e-\u0442\u043e \u0434\u0440\u0443\u0433\u043e\u0433\u043e?",options:["\u041c\u0435\u0442\u0430\u0444\u043e\u0440\u0430","\u0421\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u0435","\u0421\u0438\u043c\u0432\u043e\u043b\u0438\u0437\u043c","\u0410\u043b\u043b\u0438\u0442\u0435\u0440\u0430\u0446\u0438\u044f"],answer:3},{id:"3-4",question:"\u0412 \u0445\u0438\u043c\u0438\u0438, \u043a\u0430\u043a \u043d\u0430\u0437\u044b\u0432\u0430\u0435\u0442\u0441\u044f \u043f\u0440\u043e\u0446\u0435\u0441\u0441 \u043f\u0440\u0435\u0432\u0440\u0430\u0449\u0435\u043d\u0438\u044f \u0436\u0438\u0434\u043a\u043e\u0441\u0442\u0438 \u0432 \u0442\u0432\u0435\u0440\u0434\u043e\u0435 \u0442\u0435\u043b\u043e?",options:["\u0421\u0443\u0431\u043b\u0438\u043c\u0430\u0446\u0438\u044f","\u0418\u0441\u043f\u0430\u0440\u0435\u043d\u0438\u0435","\u041a\u043e\u043d\u0434\u0435\u043d\u0441\u0430\u0446\u0438\u044f","\u0417\u0430\u043c\u0435\u0440\u0437\u0430\u043d\u0438\u0435"],answer:4},{id:"3-5",question:"\u041a\u0430\u043a\u043e\u0439 \u0438\u0437 \u044d\u0442\u0438\u0445 \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u044b\u0445 \u0430\u0432\u0442\u043e\u0440\u043e\u0432 \u043f\u0438\u0441\u0430\u043b \u043f\u043e\u0434 \u043f\u0441\u0435\u0432\u0434\u043e\u043d\u0438\u043c\u043e\u043c '\u041b\u044c\u044e\u0438\u0441 \u041a\u044d\u0440\u0440\u043e\u043b\u043b'?",options:["\u0414\u0436\u043e\u0440\u0434\u0436 \u041e\u0440\u0443\u044d\u043b\u043b","\u0427\u0430\u0440\u043b\u044c\u0437 \u0414\u0438\u043a\u043a\u0435\u043d\u0441","\u0414\u0436.\u041a. \u0420\u043e\u0443\u043b\u0438\u043d\u0433","\u0427\u0430\u0440\u043b\u044c\u0437 \u041b\u044e\u0442\u0432\u0438\u0434\u0436 \u0414\u043e\u0434\u0436\u0441\u043e\u043d"],answer:4},{id:"3-6",question:"\u041a\u0430\u043a\u043e\u0432\u043e \u043d\u0430\u0443\u0447\u043d\u043e\u0435 \u043d\u0430\u0437\u0432\u0430\u043d\u0438\u0435 \u0444\u0435\u043d\u043e\u043c\u0435\u043d\u0430 '\u0421\u0435\u0432\u0435\u0440\u043d\u043e\u0435 \u0441\u0438\u044f\u043d\u0438\u0435'?",options:["\u0410\u0432\u0440\u043e\u0440\u0430 \u0411\u043e\u0440\u0435\u0430\u043b\u0438\u0441","\u0421\u0435\u0440\u0435\u0431\u0440\u0438\u0441\u0442\u044b\u0435 \u043e\u0431\u043b\u0430\u043a\u0430","\u0417\u043e\u0434\u0438\u0430\u043a\u0430\u043b\u044c\u043d\u044b\u0439 \u0441\u0432\u0435\u0442","\u0421\u0432\u0435\u0447\u0435\u043d\u0438\u0435 \u043d\u043e\u0447\u043d\u043e\u0433\u043e \u043d\u0435\u0431\u0430"],answer:1},{id:"3-7",question:"\u041a\u0442\u043e \u0438\u0437 \u044d\u0442\u0438\u0445 \u0438\u0441\u0442\u043e\u0440\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u043b\u0438\u0447\u0