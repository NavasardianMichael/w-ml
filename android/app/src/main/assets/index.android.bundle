76\u056b \u057a\u0561\u057f\u0574\u0561\u056f\u0561\u0576 \u056a\u0561\u0574\u0561\u0576\u0561\u056f\u0561\u0577\u0580\u057b\u0561\u0576\u0568 \u0562\u0576\u0578\u0582\u0569\u0561\u0563\u0580\u057e\u0578\u0582\u0574 \u0567 \u0564\u0580\u0561\u0576\u0581\u056b\u0581 \u0578\u055e\u0580 \u0574\u0565\u056f\u056b \u057e\u0580\u0561 \u056f\u0565\u0576\u057f\u0580\u0578\u0576\u0561\u0576\u0561\u056c\u0578\u057e\u0589",options:["\u0540\u0561\u057e\u0561\u057f \u0587 \u0576\u057e\u056b\u0580\u0578\u0582\u0574","\u0532\u0561\u0576\u0561\u056f\u0561\u0576\u0578\u0582\u0569\u0575\u0578\u0582\u0576 \u0587 \u0561\u0576\u0570\u0561\u057f\u0561\u056f\u0561\u0576\u0578\u0582\u0569\u0575\u0578\u0582\u0576","\u0546\u057e\u0561\u0573\u0578\u0582\u0574 \u0587 \u0568\u0576\u0564\u056c\u0561\u0575\u0576\u0578\u0582\u0574","\u054d\u0576\u0561\u0570\u0561\u057e\u0561\u057f\u0578\u0582\u0569\u0575\u0578\u0582\u0576 \u0587 \u0562\u0561\u0576\u0561\u0570\u0575\u0578\u0582\u057d\u0578\u0582\u0569\u0575\u0578\u0582\u0576"],answer:2},{id:"2-2",question:"\u0548\u055e\u0580\u0576 \u0567 \u0570\u0561\u0576\u0580\u0561\u0575\u056b\u0576 \u0565\u056c\u0578\u0582\u0575\u0569\u0576\u0565\u0580\u056b \u057e\u0561\u056d\u056b \u0563\u056b\u057f\u0561\u056f\u0561\u0576 \u057f\u0565\u0580\u0574\u056b\u0576\u0568\u0589",options:["\u0531\u0563\u0578\u0580\u0561\u0586\u0578\u0562\u056b\u0561","\u0533\u056c\u0578\u057d\u057d\u0578\u0586\u0578\u0562\u056b\u0561","\u053f\u056c\u0561\u0578\u0582\u057d\u057f\u0580\u0578\u0586\u0578\u0562\u056b\u0561","\u0540\u056b\u0564\u0580\u0578\u0586\u0578\u0562\u056b\u0561"],answer:2},{id:"2-3",question:"\u054b\u0561\u056f\u0578\u0574\u0578 \u054a\u0578\u0582\u0579\u056b\u0576\u056b\u056b \u056f\u0578\u0572\u0574\u056b\u0581 \u0563\u0580\u057e\u0561\u056e \u0578\u055e\u0580 \u0570\u0561\u0575\u057f\u0576\u056b \u0585\u057a\u0565\u0580\u0561\u0576 \u0567 \u057f\u0565\u0572\u056b \u0578\u0582\u0576\u0565\u0576\u0578\u0582\u0574 \u0540\u057c\u0578\u0574\u0578\u0582\u0574\u0589",options:["\u0532\u0578\u0570\u0565\u0574","\u0544\u0561\u0564\u0561\u0574 \u0532\u0561\u057f\u0565\u0580\u0586\u056c\u0561\u0575","\u054f\u0578\u0582\u0580\u0561\u0576\u0564\u0578\u057f","\u054f\u0578\u057d\u056f\u0561"],answer:4},{id:"2-4",question:"\u053b\u055e\u0576\u0579 \u0567 \u056f\u0578\u0579\u057e\u0578\u0582\u0574 \u0561\u0575\u0576 \u0576\u0575\u0578\u0582\u0569\u0568, \u0578\u0580\u0576 \u0561\u0580\u0561\u0563\u0561\u0581\u0576\u0578\u0582\u0574 \u0567 \u0584\u056b\u0574\u056b\u0561\u056f\u0561\u0576 \u057c\u0565\u0561\u056f\u0581\u056b\u0561\u0576\u055d \u0579\u057d\u057a\u0561\u057c\u057e\u0565\u056c\u0578\u057e \u0561\u0575\u0564 \u0568\u0576\u0569\u0561\u0581\u0584\u0578\u0582\u0574\u0589",options:["\u053b\u0576\u0570\u056b\u0562\u056b\u057f\u0578\u0580","\u053f\u0561\u057f\u0561\u056c\u056b\u0566\u0561\u057f\u0578\u0580","\u053c\u0578\u0582\u056e\u056b\u0579","\u0556\u0565\u0580\u0574\u0565\u0576\u057f"],answer:2},{id:"2-5",question:"\u0548\u055e\u0580\u0576 \u0567 \u0561\u0575\u0576 \u0570\u0578\u0580\u056b\u0576\u057e\u0561\u056e \u0584\u0561\u0572\u0561\u0584\u056b \u0561\u0576\u0578\u0582\u0576\u0568, \u0578\u0580\u057f\u0565\u0572 \u0561\u057a\u0580\u0578\u0582\u0574 \u0565\u0576 \xab\u054d\u056b\u0574\u0583\u057d\u0578\u0576\u0576\u0565\u0580\u0568\xbb\u0589",options:["\u054d\u0583\u0580\u056b\u0576\u0563\u0586\u056b\u056c\u0564","\u0554\u0578\u0582\u0561\u0570\u0578\u0563","\u054d\u0561\u0578\u0582\u0569 \u0553\u0561\u0580\u0584","\u0532\u0565\u0564\u0580\u0578\u0584"],answer:1},{id:"2-6",question:"\u0548\u055e\u0580\u0576 \u0567 \u0540\u0561\u057e\u0561\u0575\u0561\u0576 \u056f\u0572\u0566\u0578\u0582 \u057e\u0580\u0561 \u0563\u057f\u0576\u057e\u0578\u0572 \u0570\u0561\u0575\u057f\u0576\u056b \u0561\u057d\u057f\u0572\u0561\u0563\u056b\u057f\u0561\u056f\u0561\u0576 \u0561\u057d\u057f\u0572\u0561\u0564\u056b\u057f\u0561\u0580\u0561\u0576\u056b \u0561\u0576\u057e\u0561\u0576\u0578\u0582\u0574\u0568\u0589",options:["\u0540\u0561\u0562\u056c \u057f\u056b\u0565\u0566\u0565\u0580\u0561\u056f\u0561\u0576 \u0561\u057d\u057f\u0572\u0561\u0564\u056b\u057f\u0561\u056f","\u0531\u0580\u0565\u057d\u056b\u0562\u0578\u0575\u056b \u0561\u057d\u057f\u0572\u0561\u0564\u056b\u057f\u0561\u0580\u0561\u0576","\u0544\u0561\u0578\u0582\u0576\u0561 \u053f\u0565\u0561 \u0561\u057d\u057f\u0572\u0561\u0564\u056b\u057f\u0561\u0580\u0561\u0576","\u054a\u0561\u056c\u0578\u0574\u0561\u0580\u056b \u0561\u057d\u057f\u0572\u0561\u0564\u056b\u057f\u0561\u0580\u0561\u0576"],answer:3},{id:"2-7",question:"\u054e\u0565\u0580\u0561\u056e\u0576\u0576\u0564\u056b \u0564\u0561\u0580\u0561\u0577\u0580\u057b\u0561\u0576\u0568, \u0578\u0580\u0568 \u0570\u0561\u0575\u057f\u0576\u056b \u0567 \u056b\u0580 \u0561\u0580\u057e\u0565\u057d\u057f\u0578\u057e \u0587 \u0574\u0577\u0561\u056f\u0578\u0582\u0575\u0569\u0578\u057e, \u057d\u056f\u057d\u057e\u0565\u055e\u056c \u0567 \u0578\u055e\u0580 \u0565\u0580\u056f\u0580\u0578\u0582\u0574\u0589",options:["\u0556\u0580\u0561\u0576\u057d\u056b\u0561","\u053b\u057d\u057a\u0561\u0576\u056b\u0561","\u053b\u057f\u0561\u056c\u056b\u0561","\u0533\u0565\u0580\u0574\u0561\u0576\u056b\u0561"],answer:3},{id:"2-8",question:"\u0556\u056b\u0576\u0561\u0576\u057d\u0576\u0565\u0580\u056b \u0561\u0577\u056d\u0561\u0580\u0570\u0578\u0582\u0574, \u056b\u055e\u0576\u0579 \u0567 \u056f\u0578\u0579\u057e\u0578\u0582\u0574 \u0561\u0580\u056a\u0565\u0569\u0572\u0569\u0565\u0580\u056b \u0563\u0576\u0565\u0580\u056b \u0570\u0561\u0576\u056f\u0561\u0580\u056e\u0561\u056f\u056b, \u056f\u057f\u0580\u0578\u0582\u056f \u0561\u0576\u056f\u0578\u0582\u0574\u0568 \u0566\u0563\u0561\u056c\u056b \u0569\u057e\u0578\u057e \u0561\u0580\u056a\u0565\u0569\u0572\u0569\u0565\u0580\u056b \u0577\u0580\u057b\u0561\u0576\u0578\u0582\u0574\u0589",options:["\u0551\u0578\u0582\u056c \u0577\u0578\u0582\u056f\u0561","\u0531\u0580\u057b \u0577\u0578\u0582\u056f\u0561","\u0547\u0578\u0582\u056f\u0561\u0575\u056b \u0583\u056c\u0578\u0582\u0566\u0578\u0582\u0574","\u054c\u0565\u0581\u0565\u057d\u056b\u0561"],answer:3},{id:"2-9",question:"\u0534\u0580\u0561\u0576\u0581\u056b\u0581 \u0578\u055e\u0580\u0576 \u0567 \u0537\u0564\u057e\u0561\u0580\u0564 \u0544\u0578\u0582\u0576\u0579\u056b \u0570\u0561\u0575\u057f\u0576\u056b \u0576\u056f\u0561\u0580\u056b \u0561\u0576\u057e\u0561\u0576\u0578\u0582\u0574\u0568\u0589",options:["\u0540\u056b\u0577\u0578\u0572\u0578\u0582\u0569\u0575\u0561\u0576 \u056f\u0561\u0575\u0578\u0582\u0576\u0578\u0582\u0569\u0575\u0578\u0582\u0576","\u0543\u056b\u0579","\u0533\u0565\u0580\u0576\u056b\u056f\u0561","\u0531\u057d\u057f\u0572\u0561\u056c\u056b\u0581 \u0563\u056b\u0577\u0565\u0580"],answer:2},{id:"2-10",question:"\u0540\u0561\u0575\u057f\u0576\u056b \xab\u0544\u0578\u0562\u056b \u0534\u056b\u056f\xbb \u057e\u0565\u057a\u0568 \u057a\u0561\u057f\u0574\u0578\u0582\u0574 \u0567 \u056f\u0561\u057a\u056b\u057f\u0561\u0576 \u0531\u0570\u0561\u0562\u056b \u0578\u0580\u057d\u056b \u0574\u0561\u057d\u056b\u0576\u055d \u0574\u0565\u056e \u057d\u057a\u056b\u057f\u0561\u056f \u056f\u0565\u057f\u056b \u0570\u0565\u057f\u0587\u056b\u0581\u0589 \u053b\u055e\u0576\u0579 \u0567 \u056f\u0565\u057f\u056b \u0561\u0576\u0578\u0582\u0576\u0568\u0589",options:["\u053c\u0587\u056b\u0561\u0569\u0561\u0576","\u0544\u0578\u0562\u056b \u0534\u056b\u056f","\u053f\u0561\u057a\u0578\u0582\u0575\u057f \u0574\u0578\u0580\u0578\u0582\u0584","\u0555\u0580\u056f\u0561"],answer:2}],[{id:"3-1",question:"\xabTabula rasa\xbb (\u0574\u0561\u0584\u0578\u0582\u0580 \u057f\u0561\u056d\u057f\u0561\u056f) \u0583\u056b\u056c\u056b\u057d\u0578\u0583\u0561\u0575\u0561\u056f\u0561\u0576 \u0570\u0561\u0575\u0565\u0581\u0561\u056f\u0561\u0580\u0563\u0576 \u0561\u057c\u0561\u057e\u0565\u056c \u057d\u0565\u0580\u057f\u0578\u0580\u0565\u0576 \u056f\u0561\u057a\u057e\u0561\u056e \u0567 \u0578\u055e\u0580 \u0583\u056b\u056c\u056b\u057d\u0578\u0583\u0561\u0575\u056b \u0570\u0565\u057f\u0589",options:["\u054a\u056c\u0561\u057f\u0578\u0576","\u054b\u0578\u0576 \u053c\u0578\u056f","\u054d\u0578\u056f\u0580\u0561\u057f\u0565\u057d","\u053b\u0574\u0561\u0576\u0578\u0582\u056b\u056c \u053f\u0561\u0576\u057f"],answer:2},{id:"3-2",question:"\u0531\u0576\u0563\u056c\u056b\u0561\u0575\u0578\u0582\u0574 \xab\u054e\u0561\u0580\u0564\u0565\u0580\u056b \u057a\u0561\u057f\u0565\u0580\u0561\u0566\u0574\u056b\xbb \u056a\u0561\u0574\u0561\u0576\u0561\u056f \u0578\u055e\u0580 \u0565\u0580\u056f\u0578\u0582 \u057f\u0576\u0565\u0580\u0576 \u0567\u056b\u0576 \u056f\u0578\u0576\u0586\u056c\u056b\u056f\u057f\u056b \u0574\u0565\u057b\u0589",options:["\u0539\u0575\u0578\u0582\u0564\u0578\u0580 \u0587 \u054d\u057f\u0575\u0578\u0582\u0561\u0580\u057f","\u0545\u0578\u0580\u0584 \u0587 \u053c\u0561\u0576\u056f\u0561\u057d\u057f\u0565\u0580","\u054e\u056b\u0576\u0571\u0578\u0580 \u0587 \u0540\u0561\u0576\u0578\u057e\u0565\u0580","\u054a\u056c\u0561\u0576\u057f\u0561\u0563\u0565\u0576\u0565\u057f \u0587 \u0539\u0575\u0578\u0582\u0564\u0578\u0580"],answer:2},{id:"3-3",question:"\u053b\u055e\u0576\u0579 \u0567 \u056f\u0578\u0579\u057e\u0578\u0582\u0574 \u0563\u0580\u0561\u056f\u0561\u0576 \u0570\u0576\u0561\u0580\u0584\u0568, \u0578\u0580\u057f\u0565\u0572 \u0570\u0565\u0572\u056b\u0576\u0561\u056f\u0576 \u0585\u0563\u057f\u0561\u0563\u0578\u0580\u056e\u0578\u0582\u0574 \u0567 \u0561\u057c\u0561\u0580\u056f\u0561 \u056f\u0561\u0574 \u0563\u0561\u0572\u0561\u0583\u0561\u0580\u055d \u0574\u0565\u056f \u0561\u0575\u056c \u0562\u0561\u0576 \u0576\u0565\u0580\u056f\u0561\u0575\u0561\u0581\u0576\u0565\u056c\u0578\u0582 \u0570\u0561\u0574\u0561\u0580\u0589",options:["\u0544\u0565\u057f\u0561\u0586\u0578\u0580","\u0540\u0561\u0574\u0565\u0574\u0561\u057f\u0578\u0582\u0569\u0575\u0578\u0582\u0576","\u054d\u056b\u0574\u057e\u0578\u056c\u056b\u0566\u0574","\u0531\u056c\u056b\u057f\u0565\u0580\u0561\u0581\u056b\u0561"],answer:3},{id:"3-4",question:"\u0554\u056b\u0574\u056b\u0561\u0575\u0578\u0582\u0574 \u056b\u055e\u0576\u0579 \u0567 \u056f\u0578\u0579\u057e\u0578\u0582\u0574 \u0570\u0565\u0572\u0578\u0582\u056f\u0568 \u057a\u056b\u0576\u0564 \u0574\u0561\u0580\u0574\u0576\u056b \u057e\u0565\u0580\u0561\u056e\u0565\u056c\u0578\u0582 \u0563\u0578\u0580\u056e\u0568\u0576\u0569\u0561\u0581\u0568\u0589",options:["\u054d\u0578\u0582\u0562\u056c\u056b\u0574\u0561\u0581\u056b\u0561","\u0533\u0578\u056c\u0578\u0580\u0577\u056b\u0561\u0581\u0578\u0582\u0574","\u053d\u057f\u0561\u0581\u0578\u0582\u0574","\u054d\u0561\u057c\u0565\u0581\u0578\u0582\u0574"],answer:4},{id:"3-5",question:"\u0548\u055e\u0580 \u0570\u0561\u0575\u057f\u0576\u056b \u0570\u0565\u0572\u056b\u0576\u0561\u056f\u0576 \u0567 \u0563\u0580\u0565\u056c '\u053c\u0578\u0582\u056b\u057d \u0554\u0565\u0580\u0578\u056c' \u056f\u0565\u0572\u056e\u0561\u0576\u0578\u0582\u0576\u0578\u057e\u0589",options:["\u054b\u0578\u0580\u057b \u0555\u0580\u0578\u0582\u0565\u056c","\u0549\u0561\u0580\u056c\u0566 \u0534\u056b\u0584\u0565\u0576\u057d","\u054b.\u053f. \u054c\u0578\u0578\u0582\u056c\u056b\u0576\u0563","\u0549\u0561\u0580\u056c\u0566 \u053c\u0578\u0582\u0569\u057e\u056b\u057b \u0534\u0578\u057b\u057d\u0578\u0576"],answer:4},{id:"3-6",question:"\u0548\u055e\u0580\u0576 \u0567 \xab\u0540\u0575\u0578\u0582\u057d\u056b\u057d\u0561\u0575\u056b\u0576 \u056c\u0578\u0582\u0575\u057d\u0565\u0580\xbb \u0565\u0580\u0587\u0578\u0582\u0575\u0569\u056b \u0563\u056b\u057f\u0561\u056f\u0561\u0576 \u0561\u0576\u057e\u0561\u0576\u0578\u0582\u0574\u0568\u0589",options:["\u0531\u057e\u0580\u0578\u0580\u0561 \u0532\u0578\u0580\u0565\u0561\u056c\u056b\u057d","\u0533\u056b\u0577\u0565\u0580\u0561\u056c\u0578\u0582\u057d\u056b\u0576\u0561\u0575\u056b\u0576 \u0561\u0574\u057a\u0565\u0580","\u0536\u0578\u0564\u056b\u0561\u056f\u0561\u0575\u056b\u0576 \u056c\u0578\u0582\u0575\u057d","\u0535\u0580\u056f\u0576\u0561\u0575\u056b\u0576 \u056c\u0578\u0582\u057d\u0561\u0580\u0571\u0561\u056f\u0578\u0582\u0574"],answer:1},{id:"3-7",question:"\u0548\u055e\u0580\u0576 \u0567 \u0561\u0575\u0576 \u0570\u057c\u0578\u0574\u0565\u0561\u0581\u056b \u0563\u056c\u0561\u0564\u056b\u0561\u057f\u0578\u0580\u056b \u0561\u0576\u0578\u0582\u0576\u0568, \u0578\u057e \u0563\u056c\u056d\u0561\u057e\u0578\u0580\u0565\u0581 \u057d\u057f\u0580\u0578\u0582\u056f\u0576\u0565\u0580\u056b \u056d\u0578\u0577\u0578\u0580 \u0561\u057a\u057d\u057f\u0561\u0574\u0562\u0578\u0582\u0569\u0575\u0578\u0582\u0576\u0589",options:["\u054d\u057a\u0561\u0580\u057f\u0561\u056f","\u0540\u0561\u0576\u0576\u056b\u0562\u0561\u056c","\u0540\u0578\u0582\u056c\u056b\u0578\u057d \u053f\u0565\u057d\u0561\u0580","\u0546\u0565\u0580\u0578\u0576"],answer:1},{id:"3-8",question:"\u0548\u055e\u0580 \u0570\u0576\u0561\u0563\u0578\u0582\u0575\u0576 \u0584\u0561\u0572\u0561\u0584\u0561\u056f\u0580\u0569\u0578\u0582\u0569\u0575\u0578\u0582\u0576\u0576 \u0567 \u0574\u0577\u0561\u056f\u0565\u056c \u0563\u0580\u0561\u057e\u0578\u0580 \u056d\u0578\u057d\u0584\u056b \u0561\u057c\u0561\u057b\u056b\u0576 \u0570\u0561\u0575\u057f\u0576\u056b \u0571\u0587\u0568\u055d \u057d\u0565\u057a\u0561\u0563\u056b\u0580\u0568\u0589",options:["\u0540\u056b\u0576 \u0535\u0563\u056b\u057a\u057f\u0578\u057d","\u0540\u056b\u0576 \u0540\u057c\u0578\u0574","\u0544\u056b\u057b\u0561\u0563\u0565\u057f\u0584","\u0540\u056b\u0576 \u0540\u0578\u0582\u0576\u0561\u057d\u057f\u0561\u0576"],answer:3},{id:"3-9",question:"\u0548\u055e\u0580\u0576 \u0567 \u0574\u0561\u0569\u0565\u0574\u0561\u057f\u056b\u056f\u0561\u056f\u0561\u0576 \u0570\u0561\u057d\u057f\u0561\u057f\u0578\u0582\u0576\u056b \u0561\u0576\u0578\u0582\u0576\u0568, \u0578\u0580\u0568 \u0574\u0578\u057f\u0561\u057e\u0578\u0580\u0561\u057a\u0565\u057d \u0570\u0561\u057e\u0561\u057d\u0561\u0580 \u0567 3.14159-\u056b\u0589",options:["\u0556\u056b","\u0537\u057a\u057d\u056b\u056c\u0578\u0576","\u054a\u056b","\u0534\u0565\u056c\u057f\u0561"],answer:3},{id:"3-10",question:"\u0547\u0561\u056d\u0574\u0561\u057f\u0578\u0582\u0574 \u0578\u055e\u0580\u0576 \u0567 \u0574\u056b\u0561\u056f \u0586\u056b\u0563\u0578\u0582\u0580\u0568, \u0578\u0580\u0568 \u056f\u0561\u0580\u0578\u0572 \u0567 \u0581\u0561\u057f\u056f\u0565\u056c \u0561\u0575\u056c \u0586\u056b\u0563\u0578\u0582\u0580\u0576\u0565\u0580\u056b \u057e\u0580\u0561\u0575\u0578\u057e\u0589",options:["\u0536\u056b\u0576\u057e\u0578\u0580","\u0546\u0561\u057e\u0561\u056f","\u0541\u056b","\u0553\u056b\u0572"],answer:3}]]}},719,[]);
__d(function(e,o,t,i,a,n,s){a.exports={"who-wants-to-be-a-millionaire":"Who Wants to Be a Millionaire?","start-game":"Start Game",settings:"Settings","option-a":"A","option-b":"B","option-c":"C","option-d":"D","currency-symbol":"$","stage-1-money-amount":"100","stage-2-money-amount":"200","stage-3-money-amount":"300","stage-4-money-amount":"500","stage-5-money-amount":"1,000","stage-6-money-amount":"2,000","stage-7-money-amount":"4,000","stage-8-money-amount":"8,000","stage-9-money-amount":"16,000","stage-10-money-amount":"32,000","stage-11-money-amount":"64,000","stage-12-money-amount":"125,000","stage-13-money-amount":"250,000","stage-14-money-amount":"500,000","stage-15-money-amount":"1,000,000","are-you-sure-you-want-to-quit":"Are you sure you want to quit?",yes:"Yes",no:"No","please-wait":"Please wait.","we-are-getting-in-with-your-friend":"We are getting in touch with your friend...","i-think-the-answer-is":"I think the answer is","which-option-do-you-think-is-correct":"Which option do you think is correct? Don't worry, you won't lose for a wrong answer. We will switch the question.",quiz:[[{id:"1-1",question:"Which large animal is known for its distinctive black and white striped coat?",options:["Tiger","Leopard","Zebra","Jaguar"],answer:3},{id:"1-2",question:"If you are playing a game of 'Rock, Paper, Scissors', what would 'paper' beat?",options:["Rock","Scissors","Paper","Lizard"],answer:1},{id:"1-3",question:"What common kitchen utensil is used to stir soup?",options:["Fork","Spoon","Knife","Chopsticks"],answer:2},{id:"1-4",question:"Which planet is famous for its bright rings?",options:["Mars","Jupiter","Saturn","Uranus"],answer:3},{id:"1-5",question:"In the world of cartoons, what is the name of SpongeBob's best friend, a starfish?",options:["Squidward","Mr. Krabs","Gary","Patrick"],answer:4},{id:"1-6",question:"Which popular toy is made of small, interlocking plastic bricks?",options:["Hot Wheels","Lego","Barbie","Nerf"],answer:2},{id:"1-7",question:"What is the common name for the gas that we breathe in to survive?",options:["Carbon dioxide","Helium","Nitrogen","Oxygen"],answer:4},{id:"1-8",question:"In the story of 'Little Red Riding Hood,' what kind of animal did the Big Bad Wolf pretend to be?",options:["Grandmother","Woodcutter","Hunter","Farmer"],answer:1},{id:"1-9",question:"Which of these is a vegetable that is also a common color name?",options:["Potato","Carrot","Onion","Lettuce"],answer:2},{id:"1-10",question:"Which musical instrument has a keyboard and a series of black and white keys?",options:["Guitar","Drums","Violin","Piano"],answer:4}],[{id:"2-1",question:"The historical period known as the 'Age of Enlightenment' is characterized by a focus on which of these?",options:["Faith and devotion","Reason and individualism","Conquest and expansion","Superstition and folklore"],answer:2},{id:"2-2",question:"What is the scientific term for the fear of public speaking?",options:["Agoraphobia","Glossophobia","Claustrophobia","Hydrophobia"],answer:2},{id:"2-3",question:"Which famous opera, written by Giacomo Puccini, is set in Rome?",options:["La Boh\xe8me","Madama Butterfly","Turandot","Tosca"],answer:4},{id:"2-4",question:"What is the term for a substance that speeds up a chemical reaction without being consumed in the process?",options:["Inhibitor","Catalyst","Solvent","Enzyme"],answer:2},{id:"2-5",question:"What is the name of the fictional town where 'The Simpsons' live?",options:["Springfield","Quahog","South Park","Bedrock"],answer:1},{id:"2-6",question:"What is the name of the famous astronomical observatory located on the island of Hawaii?",options:["Hubble Space Telescope","Arecibo Observatory","Mauna Kea Observatory","Palomar Observatory"],answer:3},{id:"2-7",question:"The 'Renaissance' period, famous for its art and culture, began in which country?",options:["France","Spain","Italy","Germany"],answer:3},{id:"2-8",question:"In the world of finance, what is the term for a sudden, sharp decline in stock prices across a significant number of stocks?",options:["Bull market","Bear market","Market crash","Recession"],answer:3},{id:"2-9",question:"Which of these is the name of a famous painting by Edvard Munch?",options:["The Persistence of Memory","The Scream","Guernica","Starry Night"],answer:2},{id:"2-10",question:"The famous novel 'Moby Dick' tells the story of Captain Ahab's hunt for a great white whale. What is the whale's name?",options:["The Leviathan","Moby Dick","Bluebeard","Orca"],answer:2}],[{id:"3-1",question:"The philosophical concept of 'tabula rasa' (blank slate) is most closely associated with which philosopher?",options:["Plato","John Locke","Socrates","Immanuel Kant"],answer:2},{id:"3-2",question:"In the 'War of the Roses' in England, which two houses were in conflict?",options:["Tudor and Stuart","York and Lancaster","Windsor and Hanover","Plantagenet and Tudor"],answer:2},{id:"3-3",question:"What is the name of the literary device where an author uses an object or idea to represent something else?",options:["Metaphor","Simile","Symbolism","Alliteration"],answer:3},{id:"3-4",question:"In chemistry, what is the process of converting a liquid to a solid called?",options:["Sublimation","Evaporation","Condensation","Freezing"],answer:4},{id:"3-5",question:"Which of these famous authors wrote under the pseudonym 'Lewis Carroll'?",options:["George Orwell","Charles Dickens","J.K. Rowling","Charles Lutwidge Dodgson"],answer:4},{id:"3-6",question:"What is the scientific name for the phenomenon of 'Northern Lights'?",options:["Aurora Borealis","Noctilucent Clouds","Zodiacal Light","Airglow"],answer:1},{id:"3-7",question:"Which of these historical figures was a Roman gladiator who led a major slave uprising?",options:["Spartacus","Hannibal","Julius Caesar","Nero"],answer:1},{id:"3-8",question:"Which ancient civilization developed the first known form of writing, cuneiform?",options:["Ancient Egypt","Ancient Rome","Mesopotamia","Ancient Greece"],answer:3},{id:"3-9",question:"What is the name of the mathematical constant approximately equal to 3.14159?",options:["Phi","Epsilon","Pi","Delta"],answer:3},{id:"3-10",question:"In the game of chess, what is the name of the only piece that can jump over other pieces?",options:["Pawn","Rook","Knight","Bishop"],answer:3}]]}},720,[]);
__d(function(o,n,s,t,i,e,a){i.exports={"who-wants-to-be-a-millionaire":"\u041a\u0442\u043e \u0445\u043e\u0447\u0435\u0442 \u0441\u0442\u0430\u0442\u044c \u043c\u0438\u043b\u043b\u0438\u043e\u043d\u0435\u0440\u043e\u043c?","start-game":"\u041d\u0430\u0447\u0430\u0442\u044c \u0438\u0433\u0440\u0443",settings:"\u041d\u0430\u0441\u0442\u0440\u043e\u0439\u043a\u0438","option-a":"\u0410","option-b":"\u0411","option-c":"\u0412","option-d":"\u0413","currency-symbol":"\u20bd","stage-1-money-amount":"100","stage-2-money-amount":"200","stage-3-money-amount":"300","stage-4-money-amount":"500","stage-5-money-amount":"1,000","stage-6-money-amount":"2,000","stage-7-money-amount":"4,000","stage-8-money-amount":"8,000","stage-9-money-amount":"16,000","stage-10-money-amount":"32,000","stage-11-money-amount":"64,000","stage-12-money-amount":"125,000","stage-13-money-amount":"250,000","stage-14-money-amount":"500,000","stage-15-money-amount":"1,000,000","are-you-sure-you-want-to-quit":"\u0412\u044b \u0443\u0432\u0435\u0440\u0435\u043d\u044b, \u0447\u0442\u043e \u0445\u043e\u0442\u0438\u0442\u0435 \u0432\u044b\u0439\u0442\u0438?",yes:"\u0414\u0430",no:"\u041d\u0435\u0442","please-wait":"\u041f\u043e\u0436\u0430\u043b\u0443\u0439\u0441\u0442\u0430, \u043f\u043e\u0434\u043e\u0436\u0434\u0438\u0442\u0435.","we-are-getting-in-with-your-friend":"\u041c\u044b \u0441\u0432\u044f\u0437\u044b\u0432\u0430\u0435\u043c\u0441\u044f \u0441 \u0432\u0430\u0448\u0438\u043c \u0434\u0440\u0443\u0433\u043e\u043c...","i-think-the-answer-is":"\u042f \u0434\u0443\u043c\u0430\u044e, \u0447\u0442\u043e \u043f\u0440\u0430\u0432\u0438\u043b\u044c\u043d\u044b\u0439 \u043e\u0442\u0432\u0435\u0442 -","which-option-do-you-think-is-correct":"\u041a\u0430\u043a\u043e\u0439 \u0432\u0430\u0440\u0438\u0430\u043d\u0442, \u043f\u043e \u0432\u0430\u0448\u0435\u043c\u0443 \u043c\u043d\u0435\u043d\u0438\u044e, \u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f \u043f\u0440\u0430\u0432\u0438\u043b\u044c\u043d\u044b\u043c? \u041d\u0435 \u0432\u043e\u043b\u043d\u0443\u0439\u0442\u0435\u0441\u044c, \u0432\u044b \u043d\u0435 \u043f\u0440\u043e\u0438\u0433\u0440\u0430\u0435\u0442\u0435 \u0437\u0430 \u043d\u0435\u043f\u0440\u0430\u0432\u0438\u043b\u044c\u043d\u044b\u0439 \u043e\u0442\u0432\u0435\u0442. \u041c\u044b \u0441\u043c\u0435\u043d\u0438\u043c \u0432\u043e\u043f\u0440\u043e\u0441.",quiz:[[{id:"1-1",question:"\u041a\u0430\u043a\u043e\u0435 \u043a\u0440\u0443\u043f\u043d\u043e\u0435 \u0436\u0438\u0432\u043e\u0442\u043d\u043e\u0435 \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u043e \u0441\u0432\u043e\u0438\u043c \u0445\u0430\u0440\u0430\u043a\u0442\u0435\u0440\u043d\u044b\u043c \u0447\u0435\u0440\u043d\u043e-\u0431\u0435\u043b\u044b\u043c \u043f\u043e\u043b\u043e\u0441\u0430\u0442\u044b\u043c \u043e\u043a\u0440\u0430\u0441\u043e\u043c?",options:["\u0422\u0438\u0433\u0440","\u041b\u0435\u043e\u043f\u0430\u0440\u0434","\u0417\u0435\u0431\u0440\u0430","\u042f\u0433\u0443\u0430\u0440"],answer:3},{id:"1-2",question:"\u0415\u0441\u043b\u0438 \u0432\u044b \u0438\u0433\u0440\u0430\u0435\u0442\u0435 \u0432 '\u041a\u0430\u043c\u0435\u043d\u044c, \u041d\u043e\u0436\u043d\u0438\u0446\u044b, \u0411\u0443\u043c\u0430\u0433\u0430', \u0447\u0442\u043e \u043f\u043e\u0431\u0435\u0434\u0438\u0442 '\u0431\u0443\u043c\u0430\u0433\u0430'?",options:["\u041a\u0430\u043c\u0435\u043d\u044c","\u041d\u043e\u0436\u043d\u0438\u0446\u044b","\u0411\u0443\u043c\u0430\u0433\u0430","\u042f\u0449\u0435\u0440\u0438\u0446\u0430"],answer:1},{id:"1-3",question:"\u041a\u0430\u043a\u043e\u0439 \u043a\u0443\u0445\u043e\u043d\u043d\u044b\u0439 \u043f\u0440\u0438\u0431\u043e\u0440 \u043e\u0431\u044b\u0447\u043d\u043e \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u0435\u0442\u0441\u044f \u0434\u043b\u044f \u0440\u0430\u0437\u043c\u0435\u0448\u0438\u0432\u0430\u043d\u0438\u044f \u0441\u0443\u043f\u0430?",options:["\u0412\u0438\u043b\u043a\u0430","\u041b\u043e\u0436\u043a\u0430","\u041d\u043e\u0436","\u041f\u0430\u043b\u043e\u0447\u043a\